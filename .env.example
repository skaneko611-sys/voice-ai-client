# Anthropic APIキー（必須）。https://console.anthropic.com/settings/keys から発行してください。
# このキーはサーバー側でのみ使用され、ブラウザには一切送信されません。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ワークスペースに紐付いていない(組織レベルの)APIキーを使う場合のみ必要。
# Anthropic ConsoleのURL(https://console.anthropic.com/workspaces/wrkspc_xxxxx/...)に
# 含まれる wrkspc_ から始まる文字列を設定してください。
# 「This API key is not scoped to a workspace」というエラーが出た場合に設定します。
# ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxxxxxxxxxx

# 使用するClaudeモデル（省略可）
ANTHROPIC_MODEL=claude-sonnet-5

# AIの人格・応答スタイルを指定するシステムプロンプト（省略可）
SYSTEM_PROMPT=あなたは親しみやすい音声アシスタントです。声で読み上げられることを前提に、話し言葉で簡潔に(2〜3文程度)答えてください。

# サーバーのポート番号（省略可）
PORT=3000
