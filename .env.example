# OpenAI APIキー（必須）。https://platform.openai.com/api-keys から発行してください。
# このキーはサーバー側でのみ使用され、ブラウザには一切送信されません。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するRealtimeモデル（省略可）
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# AIの声（省略可）: alloy / ash / ballad / coral / echo / sage / shimmer / verse など
OPENAI_REALTIME_VOICE=verse

# サーバーのポート番号（省略可）
PORT=3000
